<Window x:Class="Example.AnalysisMonitor.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" Height="450"
        MinWidth="400" MinHeight="300"
        Background="#FF035679"
        Foreground="#FFf8fafc"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <TextBox x:Name="TxtJson" Grid.Row="1"
                 AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 Background="#FF024f6e" Foreground="#FFf97316"
                 BorderBrush="#FF334155" Padding="10"
                 FontFamily="Cascadia Code,Consolas" FontSize="12"
                 SpellCheck.IsEnabled="False"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="16,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Save" Padding="16,6" Click="BtnSave_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
